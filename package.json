{
  "name": "agent-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm -r build",
    "check:control-artifacts": "node scripts/check-control-contract-artifacts.mjs && node scripts/sync-trace-contract-version.mjs --check",
    "check:package-artifacts": "node scripts/check-package-artifacts.mjs",
    "check-types": "pnpm -r check-types",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-trace-contract-version.mjs && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "semver": "^7.8.5"
  }
}
