{
  "name": "@tangle-network/agent-provider-testkit",
  "version": "0.12.4",
  "description": "Framework-neutral conformance checks for AgentEnvironmentProvider implementations",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-sdk.git",
    "directory": "packages/agent-provider-testkit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/conformance-helpers.d.ts",
    "dist/conformance-helpers.js",
    "dist/conformance-types.d.ts",
    "dist/conformance-types.js",
    "dist/exact-process-conformance.d.ts",
    "dist/exact-process-conformance.js",
    "dist/exact-process-helpers.d.ts",
    "dist/exact-process-helpers.js",
    "dist/interactive-conformance.d.ts",
    "dist/interactive-conformance.js",
    "dist/interaction-conformance.d.ts",
    "dist/interaction-conformance.js",
    "dist/portable-context-conformance.d.ts",
    "dist/portable-context-conformance.js",
    "dist/portable-context-helpers.d.ts",
    "dist/portable-context-helpers.js",
    "dist/provider-conformance.d.ts",
    "dist/provider-conformance.js",
    "dist/session-replay-conformance.d.ts",
    "dist/session-replay-conformance.js",
    "dist/workspace-branching-conformance.d.ts",
    "dist/workspace-branching-conformance.js",
    "dist/workspace-snapshot-conformance.d.ts",
    "dist/workspace-snapshot-conformance.js",
    "dist/workspace-cleanup-conformance.d.ts",
    "dist/workspace-cleanup-conformance.js",
    "dist/live/index.d.ts",
    "dist/live/index.js",
    "dist/live/report.d.ts",
    "dist/live/report.js",
    "dist/live/probe-profile.d.ts",
    "dist/live/probe-profile.js",
    "dist/live/turns.d.ts",
    "dist/live/turns.js",
    "dist/live/context.d.ts",
    "dist/live/context.js",
    "dist/live/checks-capability.d.ts",
    "dist/live/checks-capability.js",
    "dist/live/checks-environment.d.ts",
    "dist/live/checks-environment.js",
    "dist/live/checks-turns.d.ts",
    "dist/live/checks-turns.js",
    "dist/live/checks-control.d.ts",
    "dist/live/checks-control.js",
    "dist/live/run.d.ts",
    "dist/live/run.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run src"
  },
  "dependencies": {
    "@tangle-network/agent-interface": "^5.10.12",
    "@tangle-network/agent-profile-materialize": "1.1.4",
    "@tangle-network/cli-agent-registry": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  }
}
