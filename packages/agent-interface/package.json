{
  "name": "@tangle-network/agent-interface",
  "version": "0.52.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./environment-provider": {
      "import": "./dist/environment-provider.js",
      "types": "./src/environment-provider.ts"
    },
    "./profile": {
      "import": "./dist/agent-profile.js",
      "types": "./src/agent-profile.ts"
    },
    "./profile-snapshot": {
      "import": "./dist/agent-profile-snapshot.js",
      "types": "./src/agent-profile-snapshot.ts"
    },
    "./profile-schema": {
      "import": "./dist/profile-schema.js",
      "types": "./src/profile-schema.ts"
    },
    "./profile-security": {
      "import": "./dist/profile-security.js",
      "types": "./src/profile-security.ts"
    },
    "./harness": {
      "import": "./dist/harness.js",
      "types": "./src/harness.ts"
    },
    "./harness-capabilities": {
      "import": "./dist/harness-capabilities.js",
      "types": "./src/harness-capabilities.ts"
    },
    "./interaction": {
      "import": "./dist/interaction.js",
      "types": "./src/interaction.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-sdk.git",
    "directory": "packages/agent-interface"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./environment-provider": {
        "import": "./dist/environment-provider.js",
        "types": "./dist/environment-provider.d.ts",
        "default": "./dist/environment-provider.js"
      },
      "./profile": {
        "import": "./dist/agent-profile.js",
        "types": "./dist/agent-profile.d.ts",
        "default": "./dist/agent-profile.js"
      },
      "./profile-snapshot": {
        "import": "./dist/agent-profile-snapshot.js",
        "types": "./dist/agent-profile-snapshot.d.ts",
        "default": "./dist/agent-profile-snapshot.js"
      },
      "./profile-schema": {
        "import": "./dist/profile-schema.js",
        "types": "./dist/profile-schema.d.ts",
        "default": "./dist/profile-schema.js"
      },
      "./profile-security": {
        "import": "./dist/profile-security.js",
        "types": "./dist/profile-security.d.ts",
        "default": "./dist/profile-security.js"
      },
      "./harness": {
        "import": "./dist/harness.js",
        "types": "./dist/harness.d.ts",
        "default": "./dist/harness.js"
      },
      "./harness-capabilities": {
        "import": "./dist/harness-capabilities.js",
        "types": "./dist/harness-capabilities.d.ts",
        "default": "./dist/harness-capabilities.js"
      },
      "./interaction": {
        "import": "./dist/interaction.js",
        "types": "./dist/interaction.d.ts",
        "default": "./dist/interaction.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "spdx-expression-parse": "5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/spdx-expression-parse": "4.0.0",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
