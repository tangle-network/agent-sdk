  "wireCases": [
    {
      "name": "exact-bearer",
      "request": {
        "scheme": "https",
        "authority": "reports.example.com",
        "sni": "reports.example.com",
        "method": "POST",
        "path": "/v1/events/one",
        "headers": [
          [
            "Authorization",
            "Bearer PLACEHOLDER"
          ]
        ]
      },
      "authorized": true,
      "reason": "complete credential component"
    },
    {
      "name": "substring",
      "request": {
        "headers": [
          [
            "Authorization",
            "Bearer prefixPLACEHOLDER"
          ]
        ]
      },
      "authorized": false,
      "reason": "embedded placeholder"
    },
    {
      "name": "duplicate-header",
      "request": {
        "headers": [
          [
            "Authorization",
            "Bearer PLACEHOLDER"
          ],
          [
            "authorization",
            "Bearer PLACEHOLDER"
          ]
        ]
      },
      "authorized": false,
      "reason": "case-insensitive duplicate"
    },
    {
      "name": "duplicate-query",
      "request": {
        "query": "api_key=PLACEHOLDER&api_key=PLACEHOLDER"
      },
      "authorized": false,
      "reason": "duplicate decoded selector"
    },
    {
      "name": "query-spill",
      "request": {
        "query": "other=PLACEHOLDER"
      },
      "authorized": false,
      "reason": "wrong selector"
    },
    {
      "name": "encoded-query-duplicate",
      "request": {
        "query": "api_key=PLACEHOLDER&api%5fkey=PLACEHOLDER"
      },
      "authorized": false,
      "reason": "duplicate after one percent decode"
    },
    {
      "name": "encoded-slash",
      "request": {
        "path": "/v1/events%2fone"
      },
      "authorized": false,
      "reason": "noncanonical path"
    },
    {
      "name": "authority-sni",
      "request": {
        "authority": "reports.example.com",
        "sni": "other.example.com"
      },
      "authorized": false,
      "reason": "authority and SNI must agree"
    },
    {
      "name": "http",
      "request": {
        "scheme": "http"
      },
      "authorized": false,
      "reason": "HTTPS required"
    },
    {
      "name": "alternate-port",
      "request": {
        "authority": "reports.example.com:8443"
      },
      "authorized": false,
      "reason": "443 only"
    },
    {
      "name": "wrong-basic-user",
