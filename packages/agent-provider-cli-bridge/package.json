{
  "name": "@tangle-network/agent-provider-cli-bridge",
  "version": "0.3.0",
  "description": "AgentEnvironmentProvider adapter for cli-bridge /v1/chat/completions",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-sdk.git",
    "directory": "packages/agent-provider-cli-bridge"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/cli-bridge-client.d.ts",
    "dist/cli-bridge-client.js",
    "dist/cli-bridge-limits.d.ts",
    "dist/cli-bridge-limits.js",
    "dist/cli-bridge-result-collector.d.ts",
    "dist/cli-bridge-result-collector.js",
    "dist/cli-bridge-result.d.ts",
    "dist/cli-bridge-result.js",
    "dist/cli-bridge-response.d.ts",
    "dist/cli-bridge-response.js",
    "dist/cli-bridge-runner.d.ts",
    "dist/cli-bridge-runner.js",
    "dist/cli-bridge-runs.d.ts",
    "dist/cli-bridge-runs.js",
    "dist/cli-bridge-session.d.ts",
    "dist/cli-bridge-session.js",
    "dist/cli-bridge-snapshots.d.ts",
    "dist/cli-bridge-snapshots.js",
    "dist/cli-bridge-sse.d.ts",
    "dist/cli-bridge-sse.js",
    "dist/cli-bridge-stream.d.ts",
    "dist/cli-bridge-stream.js",
    "dist/cli-bridge-transport.d.ts",
    "dist/cli-bridge-transport.js",
    "dist/cli-bridge-types.d.ts",
    "dist/cli-bridge-types.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@tangle-network/agent-interface": "0.40.0",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
