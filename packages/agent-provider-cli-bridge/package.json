{
  "name": "@tangle-network/agent-provider-cli-bridge",
  "version": "0.7.8",
  "description": "AgentEnvironmentProvider adapter for cli-bridge retained sessions and one-shot turns",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-sdk.git",
    "directory": "packages/agent-provider-cli-bridge"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/environment-identity.d.ts",
    "dist/environment-identity.js",
    "dist/capability-discovery.d.ts",
    "dist/capability-discovery.js",
    "dist/interaction-response.d.ts",
    "dist/interaction-response.js",
    "dist/observation.d.ts",
    "dist/observation.js",
    "dist/provider-options.d.ts",
    "dist/provider-options.js",
    "dist/retained-canonical-event.d.ts",
    "dist/retained-canonical-event.js",
    "dist/retained-control.d.ts",
    "dist/retained-control.js",
    "dist/retained-environment.d.ts",
    "dist/retained-environment.js",
    "dist/retained-event-cursor.d.ts",
    "dist/retained-event-cursor.js",
    "dist/retained-execution.d.ts",
    "dist/retained-execution.js",
    "dist/retained-native.d.ts",
    "dist/retained-native.js",
    "dist/retained-run-state.d.ts",
    "dist/retained-run-state.js",
    "dist/retained-stream.d.ts",
    "dist/retained-stream.js",
    "dist/transport.d.ts",
    "dist/transport.js",
    "dist/wire.d.ts",
    "dist/wire.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run src",
    "test:integration": "test -n \"$CLI_BRIDGE_INTEGRATION_ROOT\" || { echo 'CLI_BRIDGE_INTEGRATION_ROOT is required; see README' >&2; exit 1; }; vitest run tests/cli-bridge.integration.test.ts"
  },
  "dependencies": {
    "@tangle-network/agent-interface": "^1.0.1",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
