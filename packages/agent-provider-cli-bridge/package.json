{
  "name": "@tangle-network/agent-provider-cli-bridge",
  "version": "2.0.9",
  "description": "AgentEnvironmentProvider adapter for cli-bridge retained sessions and one-shot turns",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./sandbox": {
      "import": "./dist/sandbox/index.js",
      "types": "./src/sandbox/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-sdk.git",
    "directory": "packages/agent-provider-cli-bridge"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./sandbox": {
        "import": "./dist/sandbox/index.js",
        "types": "./dist/sandbox/index.d.ts",
        "default": "./dist/sandbox/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run src",
    "test:integration": "test -n \"$CLI_BRIDGE_INTEGRATION_ROOT\" || { echo 'CLI_BRIDGE_INTEGRATION_ROOT is required; see README' >&2; exit 1; }; pnpm run build && vitest run tests"
  },
  "dependencies": {
    "@tangle-network/agent-core": "^1.0.2",
    "@tangle-network/agent-interface": "^5.10.19",
    "@tangle-network/agent-profile-materialize": "1.1.4",
    "@tangle-network/cli-agent-registry": "^0.15.30",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@tangle-network/agent-provider-testkit": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  }
}
