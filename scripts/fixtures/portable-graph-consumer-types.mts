import type { AgentProfile, Budget, ResourceLimit, PromptHandle, ContinuityMode, MapItemFailurePolicy, JsonScalar, RouteMatch, RouteWhen, RouteGate, GraphNode, GraphEdge, GraphTopology, StoredGraph, GraphRunRecord, RuntimeRunCoordinates } from '@tangle-network/agent-interface';
const profile: AgentProfile = { name: 'observed sparse profile' };
const resource: ResourceLimit = { unit: 'seconds', limit: 1 };
const budget: Budget = { maxIterations: 1, maxTokens: 1, resources: { cpu: resource } };
const prompt: PromptHandle = { surface: 's', version: 1 };
const continuity: ContinuityMode = 'resume';
const failure: MapItemFailurePolicy = 'all-or-refuse';
const scalar: JsonScalar = null;
const match: RouteMatch = { pointer: '', equals: scalar };
const when: RouteWhen = { all: [match] };
const gate: RouteGate = { id: 'g', question: '?', choices: ['yes'] };
const node: GraphNode = { id: 'n', profile };
const topology: GraphTopology = { nodes: [node], edges: [], entry: [{ node: 'n', task: { raw: true } }], gates: [gate] };
const edge: GraphEdge = { kind: 'maps', from: 'n', graph: topology, join: 'n', directive: prompt, maxItems: 1, concurrency: 1, onItemFailure: failure, itemBudget: budget };
const route: GraphEdge = { kind: 'routes', from: 'n', to: { finish: 'done' }, directive: prompt, when, continuity };
const observed: StoredGraph = { digest: 'd', observed: true, nodes: [node], edges: [{ from: 'n', to: 'n' }], deliverable: {} };
const declared: StoredGraph = { digest: 'd', nodes: [node], edges: [edge, route], budget, deliverable: {} };
const record: GraphRunRecord = { graphDigest: 'd', taskDigest: 't', startedAt: 's', outcome: { kind: 'unknown', reason: 'not observed' }, cost: {}, nodeUsage: [{ nodeId: 'n', lastRecordAt: 's' }] };
const run: RuntimeRunCoordinates = { runId: 'actual', namespace: 'actual' };
void [declared, observed, record, run];
